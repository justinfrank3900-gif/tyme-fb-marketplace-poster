{
  "manifest_version": 3,
  "name": "TYME Auto - Post to Facebook Marketplace",
  "version": "1.0.0",
  "description": "Post vehicle listings to Facebook Marketplace in one click",
  "permissions": ["activeTab", "scripting", "storage", "clipboardWrite"],
  "host_permissions": [
    "https://*.autotrader.ca/*",
    "https://*.cargurus.ca/*",
    "https://*.cargurus.com/*",
    "https://*.kaizenauto.com/*",
    "https://*.facebook.com/*",
    "https://tyme-vehicle-builder.vercel.app/*",
    "https://*.vercel.app/*"
  ],
  "action": {
    "default_popup": "popup.html",
    "default_icon": {"16": "icons/icon16.png", "48": "icons/icon48.png", "128": "icons/icon128.png"}
  },
  "content_scripts": [
    {
      "matches": ["https://www.facebook.com/marketplace/create/vehicle*"],
      "js": ["content_facebook.js"],
      "run_at": "document_idle"
    }
  ],
  "background": {"service_worker": "background.js"},
  "icons": {"16": "icons/icon16.png", "48": "icons/icon48.png", "128": "icons/icon128.png"}
}
